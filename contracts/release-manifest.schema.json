{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/TheGoldenWave/Follow-up/contracts/release-manifest.schema.json",
  "title": "Follow-up release manifest",
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    }
  },
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "schemaVersion",
    "productVersion",
    "releaseDate",
    "channel",
    "minimumSupportedVersion",
    "releaseNotesUrl",
    "trustMode",
    "runtime",
    "acquisition",
    "capabilities",
    "integrity"
  ],
  "properties": {
    "$schema": {
      "const": "./contracts/release-manifest.schema.json"
    },
    "schemaVersion": {
      "const": "1.0"
    },
    "productVersion": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"
    },
    "releaseDate": {
      "type": "string",
      "format": "date"
    },
    "channel": {
      "const": "stable"
    },
    "minimumSupportedVersion": {
      "type": "null"
    },
    "releaseNotesUrl": {
      "type": "string",
      "format": "uri",
      "pattern": "^https://github\\.com/TheGoldenWave/Follow-up/releases/tag/v(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"
    },
    "trustMode": {
      "const": "github-tag-sha256"
    },
    "runtime": {
      "type": "object",
      "additionalProperties": false,
      "required": ["node"],
      "properties": {
        "node": {
          "const": ">=20.0.0"
        }
      }
    },
    "acquisition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode", "feeds"],
      "properties": {
        "mode": {
          "const": "centralized"
        },
        "feeds": {
          "type": "array",
          "minItems": 6,
          "maxItems": 6,
          "uniqueItems": true,
          "prefixItems": [
            { "const": "x" },
            { "const": "podcasts" },
            { "const": "official-blogs" },
            { "const": "newsletters" },
            { "const": "academic-papers" },
            { "const": "chinese-tech" }
          ],
          "items": false
        }
      }
    },
    "capabilities": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "officialBlogs",
        "channelSelection",
        "candidatePool",
        "digestSelection",
        "deliveryLedger",
        "atMostOnceDelivery",
        "installer",
        "doctor",
        "localAcquisition",
        "sidecars",
        "longTermFeedback",
        "reports",
        "paginatedFeed",
        "explicitReadState",
        "automaticRollback",
        "updater"
      ],
      "properties": {
        "officialBlogs": { "const": true },
        "channelSelection": { "const": true },
        "candidatePool": { "const": true },
        "digestSelection": { "const": true },
        "deliveryLedger": { "const": true },
        "atMostOnceDelivery": { "const": true },
        "installer": { "const": true },
        "doctor": { "const": true },
        "localAcquisition": { "const": false },
        "sidecars": { "const": false },
        "longTermFeedback": { "const": false },
        "reports": { "const": false },
        "paginatedFeed": { "const": false },
        "explicitReadState": { "const": false },
        "automaticRollback": { "const": false },
        "updater": { "const": false }
      }
    },
    "integrity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["trackedContent", "criticalFiles"],
      "properties": {
        "trackedContent": {
          "type": "object",
          "additionalProperties": false,
          "required": ["algorithm", "digest"],
          "properties": {
            "algorithm": { "const": "git-ls-tree-sha256-v1" },
            "digest": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
          }
        },
        "criticalFiles": {
          "type": "object",
          "additionalProperties": false,
          "required": ["algorithm", "files"],
          "properties": {
            "algorithm": { "const": "sha256" },
            "files": {
              "type": "object",
              "minProperties": 1,
              "required": [
                "LICENSE",
                "THIRD_PARTY_NOTICES.md",
                "SKILL.md",
                "VERSION",
                "config/config-schema.json",
                "contracts/candidate-feed.schema.json",
                "contracts/central-feed.schema.json",
                "contracts/digest-curation-request.schema.json",
                "contracts/digest-selection.schema.json",
                "contracts/release-manifest.schema.json",
                "docs/source-catalog.md",
                "docs/third-party/v0.1.0-dependencies.md",
                "prompts/curate-digest.md",
                "prompts/digest-intro.md",
                "prompts/summarize-blogs.md",
                "prompts/summarize-newsletter.md",
                "prompts/summarize-paper.md",
                "prompts/summarize-podcast.md",
                "prompts/summarize-tweets.md",
                "prompts/summarize-zh-sources.md",
                "prompts/translate.md",
                "scripts/candidate-feed-contract.js",
                "scripts/candidate-feed-store.js",
                "scripts/candidate-identity.js",
                "scripts/candidate-normalization.js",
                "scripts/command-line.js",
                "scripts/config-contract.js",
                "scripts/deliver.js",
                "scripts/delivery-ledger.js",
                "scripts/delivery-message.js",
                "scripts/delivery-outbox.js",
                "scripts/delivery-providers.js",
                "scripts/digest-candidates.js",
                "scripts/digest-selection-contract.js",
                "scripts/digest-selection.js",
                "scripts/digest-window.js",
                "scripts/doctor.js",
                "scripts/feed-contract.js",
                "scripts/finalize-digest.js",
                "scripts/install.js",
                "scripts/lib/diagnostics.js",
                "scripts/lib/install-worker.js",
                "scripts/lib/paths.js",
                "scripts/lib/skill-registration.js",
                "scripts/package-lock.json",
                "scripts/package.json",
                "scripts/prepare-digest.js",
                "scripts/release/build-release.sh",
                "scripts/release/check-provenance.js",
                "scripts/release/scan-secrets.js",
                "scripts/release/validate-release.js",
                "scripts/release/verify-dependency-licenses.js",
                "scripts/resolve-delivery.js",
                "scripts/schedule-gate.js",
                "scripts/source-registry.js",
                "scripts/source-status.js",
                "scripts/validate-digest-selection.js",
                "scripts/validate-feed-artifact.js"
              ],
              "properties": {
                "LICENSE": { "$ref": "#/$defs/sha256" },
                "THIRD_PARTY_NOTICES.md": { "$ref": "#/$defs/sha256" },
                "SKILL.md": { "$ref": "#/$defs/sha256" },
                "VERSION": { "$ref": "#/$defs/sha256" },
                "config/config-schema.json": { "$ref": "#/$defs/sha256" },
                "contracts/candidate-feed.schema.json": { "$ref": "#/$defs/sha256" },
                "contracts/central-feed.schema.json": { "$ref": "#/$defs/sha256" },
                "contracts/digest-curation-request.schema.json": { "$ref": "#/$defs/sha256" },
                "contracts/digest-selection.schema.json": { "$ref": "#/$defs/sha256" },
                "contracts/release-manifest.schema.json": { "$ref": "#/$defs/sha256" },
                "docs/source-catalog.md": { "$ref": "#/$defs/sha256" },
                "docs/third-party/v0.1.0-dependencies.md": { "$ref": "#/$defs/sha256" },
                "prompts/curate-digest.md": { "$ref": "#/$defs/sha256" },
                "prompts/digest-intro.md": { "$ref": "#/$defs/sha256" },
                "prompts/summarize-blogs.md": { "$ref": "#/$defs/sha256" },
                "prompts/summarize-newsletter.md": { "$ref": "#/$defs/sha256" },
                "prompts/summarize-paper.md": { "$ref": "#/$defs/sha256" },
                "prompts/summarize-podcast.md": { "$ref": "#/$defs/sha256" },
                "prompts/summarize-tweets.md": { "$ref": "#/$defs/sha256" },
                "prompts/summarize-zh-sources.md": { "$ref": "#/$defs/sha256" },
                "prompts/translate.md": { "$ref": "#/$defs/sha256" },
                "scripts/candidate-feed-contract.js": { "$ref": "#/$defs/sha256" },
                "scripts/candidate-feed-store.js": { "$ref": "#/$defs/sha256" },
                "scripts/candidate-identity.js": { "$ref": "#/$defs/sha256" },
                "scripts/candidate-normalization.js": { "$ref": "#/$defs/sha256" },
                "scripts/command-line.js": { "$ref": "#/$defs/sha256" },
                "scripts/config-contract.js": { "$ref": "#/$defs/sha256" },
                "scripts/deliver.js": { "$ref": "#/$defs/sha256" },
                "scripts/delivery-ledger.js": { "$ref": "#/$defs/sha256" },
                "scripts/delivery-message.js": { "$ref": "#/$defs/sha256" },
                "scripts/delivery-outbox.js": { "$ref": "#/$defs/sha256" },
                "scripts/delivery-providers.js": { "$ref": "#/$defs/sha256" },
                "scripts/digest-candidates.js": { "$ref": "#/$defs/sha256" },
                "scripts/digest-selection-contract.js": { "$ref": "#/$defs/sha256" },
                "scripts/digest-selection.js": { "$ref": "#/$defs/sha256" },
                "scripts/digest-window.js": { "$ref": "#/$defs/sha256" },
                "scripts/doctor.js": { "$ref": "#/$defs/sha256" },
                "scripts/feed-contract.js": { "$ref": "#/$defs/sha256" },
                "scripts/finalize-digest.js": { "$ref": "#/$defs/sha256" },
                "scripts/install.js": { "$ref": "#/$defs/sha256" },
                "scripts/lib/diagnostics.js": { "$ref": "#/$defs/sha256" },
                "scripts/lib/install-worker.js": { "$ref": "#/$defs/sha256" },
                "scripts/lib/paths.js": { "$ref": "#/$defs/sha256" },
                "scripts/lib/skill-registration.js": { "$ref": "#/$defs/sha256" },
                "scripts/package-lock.json": { "$ref": "#/$defs/sha256" },
                "scripts/package.json": { "$ref": "#/$defs/sha256" },
                "scripts/prepare-digest.js": { "$ref": "#/$defs/sha256" },
                "scripts/release/build-release.sh": { "$ref": "#/$defs/sha256" },
                "scripts/release/check-provenance.js": { "$ref": "#/$defs/sha256" },
                "scripts/release/scan-secrets.js": { "$ref": "#/$defs/sha256" },
                "scripts/release/validate-release.js": { "$ref": "#/$defs/sha256" },
                "scripts/release/verify-dependency-licenses.js": { "$ref": "#/$defs/sha256" },
                "scripts/resolve-delivery.js": { "$ref": "#/$defs/sha256" },
                "scripts/schedule-gate.js": { "$ref": "#/$defs/sha256" },
                "scripts/source-registry.js": { "$ref": "#/$defs/sha256" },
                "scripts/source-status.js": { "$ref": "#/$defs/sha256" },
                "scripts/validate-digest-selection.js": { "$ref": "#/$defs/sha256" },
                "scripts/validate-feed-artifact.js": { "$ref": "#/$defs/sha256" }
              },
              "propertyNames": {
                "not": { "const": "release-manifest.json" }
              },
              "additionalProperties": { "$ref": "#/$defs/sha256" }
            }
          }
        }
      }
    }
  }
}
