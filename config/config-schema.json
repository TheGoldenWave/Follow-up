{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "User configuration for Follow-up. Stored at ~/.follow-builders/config.json",
  "type": "object",
  "properties": {
    "acquisition": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "mode": { "type": "string", "enum": ["central", "shadow", "hybrid", "local"], "default": "central" }
      }
    },
    "platform": {
      "type": "string",
      "enum": ["openclaw", "other"],
      "description": "Detected platform: openclaw or other (Claude Code, Cursor, etc.)"
    },
    "language": {
      "type": "string",
      "enum": ["en", "zh", "bilingual"],
      "default": "en",
      "description": "Digest language: en (English), zh (Chinese), bilingual (both)"
    },
    "timezone": {
      "type": "string",
      "default": "America/Los_Angeles",
      "description": "IANA timezone string for scheduling (e.g. America/New_York, Asia/Shanghai)"
    },
    "frequency": {
      "type": "string",
      "enum": ["daily", "weekly"],
      "default": "daily",
      "description": "How often to deliver the digest"
    },
    "deliveryTime": {
      "type": "string",
      "default": "08:00",
      "description": "Time of day to deliver digest in HH:MM format (24-hour)"
    },
    "weeklyDay": {
      "type": "string",
      "enum": ["monday", "tuesday", "wednesday", "thursday", "friday", "saturday", "sunday"],
      "default": "monday",
      "description": "Day of week for weekly digests (only used when frequency is weekly)"
    },
    "scheduleApproved": {
      "type": "boolean",
      "description": "Legacy migration field; new configurations use schedule.approved"
    },
    "scheduleApprovedAt": {
      "type": "string",
      "format": "date-time",
      "description": "Legacy migration field; new configurations use schedule.approvedAt"
    },
    "schedule": {
      "type": "object",
      "description": "Normalized v0.2 schedule and its independent user approval",
      "required": ["frequency", "time", "timezone", "approved"],
      "properties": {
        "frequency": { "type": "string", "enum": ["daily", "weekly"] },
        "time": { "type": "string", "pattern": "^(?:[01][0-9]|2[0-3]):[0-5][0-9]$" },
        "timezone": { "type": "string", "minLength": 1 },
        "weeklyDay": {
          "type": "string",
          "enum": ["monday", "tuesday", "wednesday", "thursday", "friday", "saturday", "sunday"]
        },
        "approved": { "type": "boolean" },
        "approvedAt": { "type": "string", "format": "date-time" }
      },
      "allOf": [
        {
          "if": { "properties": { "frequency": { "const": "weekly" } }, "required": ["frequency"] },
          "then": { "required": ["weeklyDay"] }
        },
        {
          "if": { "properties": { "approved": { "const": true } }, "required": ["approved"] },
          "then": { "required": ["approvedAt"] }
        }
      ]
    },
    "enabledChannels": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": ["x", "podcasts", "blogs", "newsletters", "academic", "zh-tech"]
      },
      "uniqueItems": true,
      "default": ["x", "podcasts", "blogs", "newsletters", "academic", "zh-tech"],
      "description": "Central Feed channels included in personal digest selection"
    },
    "delivery": {
      "type": "object",
      "description": "How the digest is delivered to the user",
      "properties": {
        "method": {
          "type": "string",
          "enum": ["stdout", "telegram", "email"],
          "default": "stdout",
          "description": "Delivery method: stdout (terminal/agent), telegram (bot message), email (via Resend)"
        },
        "chatId": {
          "type": "string",
          "description": "Telegram chat ID (only for telegram method)"
        },
        "email": {
          "type": "string",
          "description": "Email address to send digest to (only for email method)"
        },
        "approved": {
          "type": "boolean",
          "description": "Whether this exact delivery destination was independently approved"
        },
        "approvedAt": {
          "type": "string",
          "format": "date-time",
          "description": "ISO timestamp for destination approval"
        }
      },
      "allOf": [
        {
          "if": { "properties": { "approved": { "const": true } }, "required": ["approved"] },
          "then": { "required": ["approvedAt"] }
        }
      ]
    },
    "onboardingComplete": {
      "type": "boolean",
      "default": false,
      "description": "Whether the user has completed initial setup"
    }
  }
}
